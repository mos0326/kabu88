# ===== 必須 =====
# Claude API キー: https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ===== 推奨: J-Quants API V2（JPX公式データ） =====
# https://jpx-jquants.com/ でユーザー登録 → ダッシュボードで APIキー を発行
#  - 全プラン        : バリュエーション指標・財務情報（決算短信）・決算発表予定日（Freeは12週間遅れ）
#  - Standard以上    : 信用取引残高・業種別空売り比率・空売り残高報告
#  - TDnetアドオン   : 決算短信PDFの取得
JQUANTS_API_KEY=
# 契約プランの1分あたりリクエスト上限（Free 5 / Light 60 / Standard 120 / Premium 500）
JQUANTS_RPM=60

# ===== 任意 =====
# KABU_MODEL=claude-opus-5-5
# KABU_DEMO=1   # ネットに繋がずに画面を確認するデモモード
